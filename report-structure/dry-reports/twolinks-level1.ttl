@prefix ex: <http://example.org/> .
@prefix rdf4j: <http://rdf4j.org/schema/rdf4j#> .
@prefix rsx: <http://rdf4j.org/shacl-extensions#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:TwoLinksPersonNameShape a sh:PropertyShape ;
    sh:minCount 1 ;
    sh:path ex:name .

[] a sh:ValidationReport ;
    rdf4j:truncated false ;
    rsx:graphPair _:N6430d6167bfb444592cda543aaeecb5d,
        _:N82dffd87f68249ec9cb8b4ba3684ea38 ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            rsx:graphPair _:N82dffd87f68249ec9cb8b4ba3684ea38 ;
            sh:focusNode ex:tlPerson2 ;
            sh:resultPath ex:name ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape ex:TwoLinksPersonNameShape ],
        [ a sh:ValidationResult ;
            rsx:graphPair _:N6430d6167bfb444592cda543aaeecb5d ;
            sh:focusNode ex:tlContact3 ;
            sh:resultPath ex:email ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:PatternConstraintComponent ;
            sh:sourceShape _:N23c0c6e79eab4af58779296c7ba31c19 ;
            sh:value "bad-two" ],
        [ a sh:ValidationResult ;
            rsx:graphPair _:N6430d6167bfb444592cda543aaeecb5d ;
            sh:focusNode ex:tlContact2 ;
            sh:resultPath ex:email ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:PatternConstraintComponent ;
            sh:sourceShape _:N23c0c6e79eab4af58779296c7ba31c19 ;
            sh:value "bad-one" ] .

_:N23c0c6e79eab4af58779296c7ba31c19 a sh:PropertyShape ;
    sh:path ex:email ;
    sh:pattern "^[^@]+@[^@]+$" .

_:N82dffd87f68249ec9cb8b4ba3684ea38 a rsx:GraphPair ;
    rsx:dataGraph <http://example.org/data/twolinks-a> ;
    rsx:shapesGraph <http://example.org/shapes/twolinks-a> .

_:N6430d6167bfb444592cda543aaeecb5d a rsx:GraphPair ;
    rsx:dataGraph <http://example.org/data/twolinks-b> ;
    rsx:shapesGraph <http://example.org/shapes/twolinks-b> .

