@prefix ex: <http://example.org/> .
@prefix rdf4j: <http://rdf4j.org/schema/rdf4j#> .
@prefix rsx: <http://rdf4j.org/shacl-extensions#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    rdf4j:truncated false ;
    rsx:dataGraph <http://example.org/data/bnode> ;
    rsx:shapesGraph <http://example.org/shapes/bnode> ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode ex:c5 ;
            sh:resultPath ex:email ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:PatternConstraintComponent ;
            sh:sourceShape _:Nf95e41b54adc43369a11c29d17f4faa5 ;
            sh:value "second-bad" ],
        [ a sh:ValidationResult ;
            sh:focusNode ex:c4 ;
            sh:resultPath ex:email ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:PatternConstraintComponent ;
            sh:sourceShape _:Nf95e41b54adc43369a11c29d17f4faa5 ;
            sh:value "bad-again" ],
        [ a sh:ValidationResult ;
            sh:focusNode ex:c5 ;
            sh:resultPath ex:email ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:PatternConstraintComponent ;
            sh:sourceShape _:Nf95e41b54adc43369a11c29d17f4faa5 ;
            sh:value "first-bad" ],
        [ a sh:ValidationResult ;
            sh:focusNode ex:c5 ;
            sh:resultPath ex:email ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MaxCountConstraintComponent ;
            sh:sourceShape _:Nf95e41b54adc43369a11c29d17f4faa5 ],
        [ a sh:ValidationResult ;
            sh:focusNode ex:c3 ;
            sh:resultPath ex:email ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:PatternConstraintComponent ;
            sh:sourceShape _:Nf95e41b54adc43369a11c29d17f4faa5 ;
            sh:value "also-bad" ],
        [ a sh:ValidationResult ;
            sh:focusNode ex:c2 ;
            sh:resultPath ex:email ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:PatternConstraintComponent ;
            sh:sourceShape _:Nf95e41b54adc43369a11c29d17f4faa5 ;
            sh:value "not-an-email" ] .

_:Nf95e41b54adc43369a11c29d17f4faa5 a sh:PropertyShape ;
    sh:maxCount 1 ;
    sh:path ex:email ;
    sh:pattern "^[^@]+@[^@]+$" .

