@prefix ex: <http://example.org/> .
@prefix rdf4j: <http://rdf4j.org/schema/rdf4j#> .
@prefix rsx: <http://rdf4j.org/shacl-extensions#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    rdf4j:truncated false ;
    rsx:dataGraph <http://example.org/data/logic> ;
    rsx:shapesGraph <http://example.org/shapes/logic> ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode ex:badSize ;
            sh:resultPath ex:size ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:AndConstraintComponent ;
            sh:sourceShape ex:ItemSizeShape ;
            sh:value "abcdefgh" ],
        [ a sh:ValidationResult ;
            sh:focusNode ex:badOwner ;
            sh:resultPath ex:owner ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape ex:ItemOwnerShape ;
            sh:value ex:robot ],
        [ a sh:ValidationResult ;
            sh:focusNode ex:badCode ;
            sh:resultPath ex:code ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape ex:ItemCodeShape ;
            sh:value "2026-10-09"^^xsd:date ],
        [ a sh:ValidationResult ;
            sh:focusNode ex:badColour ;
            sh:resultPath ex:colour ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NotConstraintComponent ;
            sh:sourceShape ex:ItemColourShape ;
            sh:value "none" ] .

