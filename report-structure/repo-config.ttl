# GraphDB repository config: ShaclSail over graphdb:Sail.
# Every graph that holds shapes for a scenario is on the shacl:shapesGraph list.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix rep: <http://www.openrdf.org/config/repository#>.
@prefix sr: <http://www.openrdf.org/config/repository/sail#>.
@prefix sail: <http://www.openrdf.org/config/sail#>.
@prefix graphdb: <http://www.ontotext.com/config/graphdb#>.
@prefix shacl: <http://rdf4j.org/config/sail/shacl#>.

[] a rep:Repository ;
    rep:repositoryID "report-structure" ;
    rdfs:label "SHACL report structure evidence" ;
    rep:repositoryImpl [
        rep:repositoryType "graphdb:SailRepository" ;
        sr:sailImpl [
            sail:sailType "rdf4j:ShaclSail" ;
            sail:delegate [
                sail:sailType "graphdb:Sail" ;
                graphdb:ruleset "empty" ;
                graphdb:disable-sameAs "true" ;
                graphdb:enable-context-index "true" ;
                graphdb:repository-type "file-repository" ;
                graphdb:storage-folder "storage"
            ] ;
            shacl:validationEnabled "true" ;
            shacl:eclipseRdf4jShaclExtensions "true" ;
            shacl:dashDataShapes "true" ;
            shacl:shapesGraph <http://rdf4j.org/schema/rdf4j#SHACLShapeGraph>,
                <http://example.org/shapes/simple>,
                <http://example.org/shapes/repeat>,
                <http://example.org/shapes/logic>,
                <http://example.org/shapes/bnode>,
                <http://example.org/shapes/node>,
                <http://example.org/shapes/fanout>,
                <http://example.org/shapes/recursive>,
                <http://example.org/shapes/twolinks-a>,
                <http://example.org/shapes/twolinks-b>
        ]
    ].
