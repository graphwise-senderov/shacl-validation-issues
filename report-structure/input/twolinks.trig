@prefix ex: <http://example.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Two independent data/shapes graph pairs, validated by two links in one transaction.
ex:shapes\/twolinks-a {
    ex:TwoLinksPersonShape a sh:NodeShape ;
        sh:targetClass ex:TwoLinksPerson ;
        sh:property ex:TwoLinksPersonNameShape .
    ex:TwoLinksPersonNameShape a sh:PropertyShape ;
        sh:path ex:name ; sh:minCount 1 .
}
ex:data\/twolinks-a {
    ex:tlPerson1 a ex:TwoLinksPerson ; ex:name "One" .
    ex:tlPerson2 a ex:TwoLinksPerson .
}
ex:shapes\/twolinks-b {
    ex:TwoLinksContactShape a sh:NodeShape ;
        sh:targetClass ex:TwoLinksContact ;
        sh:property [ sh:path ex:email ; sh:pattern "^[^@]+@[^@]+$" ] .
}
ex:data\/twolinks-b {
    ex:tlContact1 a ex:TwoLinksContact ; ex:email "ok@example.org" .
    ex:tlContact2 a ex:TwoLinksContact ; ex:email "bad-one" .
    ex:tlContact3 a ex:TwoLinksContact ; ex:email "bad-two" .
}
