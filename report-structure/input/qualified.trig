@prefix ex: <http://example.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Qualified value shape: a car needs at least four wheels.
ex:shapes\/qualified {
    ex:CarShape a sh:NodeShape ;
        sh:targetClass ex:Car ;
        sh:property [ sh:path ex:part ;
            sh:qualifiedValueShape [ sh:class ex:Wheel ] ;
            sh:qualifiedMinCount 4 ] .
}
ex:data\/qualified {
    ex:car1 a ex:Car ; ex:part ex:w1 , ex:w2 , ex:w3 , ex:engine .
    ex:w1 a ex:Wheel . ex:w2 a ex:Wheel . ex:w3 a ex:Wheel . ex:engine a ex:Engine .
}
