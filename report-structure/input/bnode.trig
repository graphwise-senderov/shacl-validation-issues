@prefix ex: <http://example.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Blank-node property shapes inside an IRI node shape. Three contacts with one bad
# e-mail each, and ex:c5 with two bad e-mails (pattern twice, maxCount once).
ex:shapes\/bnode {
    ex:ContactShape a sh:NodeShape ;
        sh:targetClass ex:Contact ;
        sh:property [ sh:path ex:email ; sh:pattern "^[^@]+@[^@]+$" ; sh:maxCount 1 ] ;
        sh:property [ sh:path ex:phone ; sh:datatype xsd:string ] .
}
ex:data\/bnode {
    ex:c1 a ex:Contact ; ex:email "c1@example.org" .
    ex:c2 a ex:Contact ; ex:email "not-an-email" .
    ex:c3 a ex:Contact ; ex:email "also-bad" .
    ex:c4 a ex:Contact ; ex:email "bad-again" .
    ex:c5 a ex:Contact ; ex:email "first-bad" , "second-bad" .
}
