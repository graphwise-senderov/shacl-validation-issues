@prefix ex: <http://example.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# sh:node: the address must conform to ex:AddressShape, whose own property shape fails.
ex:shapes\/node {
    ex:CustomerShape a sh:NodeShape ;
        sh:targetClass ex:Customer ;
        sh:property [ sh:path ex:address ; sh:node ex:AddressShape ] .
    ex:AddressShape a sh:NodeShape ;
        sh:property [ sh:path ex:postcode ; sh:minCount 1 ; sh:pattern "^[0-9]{4}$" ] .
}
ex:data\/node {
    ex:cust1 a ex:Customer ; ex:address ex:addr1 .
    ex:addr1 ex:postcode "1000" .
    ex:cust2 a ex:Customer ; ex:address ex:addr2 .
    ex:addr2 ex:postcode "ABC" .
}
