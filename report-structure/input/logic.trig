@prefix ex: <http://example.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# sh:or, sh:and, sh:xone, sh:not with blank-node members, plus sh:or over IRI node shapes.
# ex:badColour2 ("blue") violates only sh:xone.
ex:shapes\/logic {
    ex:ItemShape a sh:NodeShape ;
        sh:targetClass ex:Item ;
        sh:property ex:ItemCodeShape , ex:ItemSizeShape , ex:ItemColourShape , ex:ItemOwnerShape .

    # value must be a string or an integer
    ex:ItemCodeShape a sh:PropertyShape ; sh:path ex:code ;
        sh:or ( [ sh:datatype xsd:string ] [ sh:datatype xsd:integer ] ) .

    # value must be 2 to 5 characters long
    ex:ItemSizeShape a sh:PropertyShape ; sh:path ex:size ;
        sh:and ( [ sh:minLength 2 ] [ sh:maxLength 5 ] ) .

    # exactly one of: in the palette, or a hex code; and never "none"
    ex:ItemColourShape a sh:PropertyShape ; sh:path ex:colour ;
        sh:xone ( [ sh:in ( "red" "green" ) ] [ sh:pattern "^#[0-9a-f]{6}$" ] ) ;
        sh:not [ sh:hasValue "none" ] .

    # owner must conform to one of two named node shapes
    ex:ItemOwnerShape a sh:PropertyShape ; sh:path ex:owner ;
        sh:or ( ex:PersonOwnerShape ex:OrgOwnerShape ) .
    ex:PersonOwnerShape a sh:NodeShape ; sh:class ex:Person .
    ex:OrgOwnerShape a sh:NodeShape ; sh:class ex:Org .
}
ex:data\/logic {
    ex:goodItem a ex:Item ; ex:code "A1" ; ex:size "ab" ; ex:colour "red" ; ex:owner ex:p1 .
    ex:p1 a ex:Person .
    ex:badCode a ex:Item ; ex:code "2026-10-09"^^xsd:date .
    ex:badSize a ex:Item ; ex:size "abcdefgh" .
    ex:badColour a ex:Item ; ex:colour "none" .
    ex:badColour2 a ex:Item ; ex:colour "blue" .
    ex:badOwner a ex:Item ; ex:owner ex:robot .
    ex:robot a ex:Machine .
}
