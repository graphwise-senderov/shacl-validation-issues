@prefix rsx: <http://rdf4j.org/shacl-extensions#> .
@prefix ex: <http://example.org/> .

# Two links in one transaction: one report with results from two graph pairs.
ex:link\/twolinks-a a rsx:DataAndShapesGraphLink ;
    rsx:dataGraph ex:data\/twolinks-a ;
    rsx:shapesGraph ex:shapes\/twolinks-a .
ex:link\/twolinks-b a rsx:DataAndShapesGraphLink ;
    rsx:dataGraph ex:data\/twolinks-b ;
    rsx:shapesGraph ex:shapes\/twolinks-b .
