@prefix rsx: <http://rdf4j.org/shacl-extensions#> .
@prefix ex: <http://example.org/> .

# Post into rdf4j:SHACLShapeGraph. Validates ex:data/single-graph against ex:shapes/single-graph.
ex:link\/single-graph a rsx:DataAndShapesGraphLink ;
    rsx:dataGraph ex:data\/single-graph ;
    rsx:shapesGraph ex:shapes\/single-graph .
