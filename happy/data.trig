@prefix ex: <http://example.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Shapes, in a graph that is on the allow-list.
ex:shapes\/person {
    ex:PersonShape a sh:NodeShape ;
        sh:targetClass ex:Person ;
        sh:property [ sh:path ex:name ; sh:minCount 1 ; sh:datatype xsd:string ] ;
        sh:property [ sh:path ex:age ; sh:datatype xsd:integer ; sh:minInclusive 0 ] .
}

# Data. ex:bob has no name and ex:carol has a negative age.
ex:data\/people {
    ex:alice a ex:Person ; ex:name "Alice" ; ex:age 34 .
    ex:bob   a ex:Person ; ex:age 41 .
    ex:carol a ex:Person ; ex:name "Carol" ; ex:age -5 .
}
