# Upload into the graph rdf4j:SHACLShapeGraph.
# Validates ex:data/people against the shapes in ex:shapes/person.
@prefix rsx: <http://rdf4j.org/shacl-extensions#> .
@prefix ex: <http://example.org/> .

ex:validate\/people a rsx:DataAndShapesGraphLink ;
    rsx:dataGraph ex:data\/people ;
    rsx:shapesGraph ex:shapes\/person .
