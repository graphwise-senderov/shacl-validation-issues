# Upload into the graph rdf4j:SHACLShapeGraph.
# Validates ex:data/companies (with ex:data/people for the ex:Person types)
# against the shapes in ex:shapes/company.
@prefix rsx: <http://rdf4j.org/shacl-extensions#> .
@prefix ex: <http://example.org/> .

ex:validate\/companies a rsx:DataAndShapesGraphLink ;
    rsx:dataGraph ex:data\/companies, ex:data\/people ;
    rsx:shapesGraph ex:shapes\/company .
